<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the exe needs no runtime install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Couchpotato</RootNamespace>
    <AssemblyName>Couchpotato</AssemblyName>
    <ApplicationIcon>Couchpotato.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The core is compiled into the exe rather than referenced as Couchpotato.Core.dll: Windows would load an
      old Couchpotato.Core.dll lying next to the exe (say, from copying a build folder) instead of the
      embedded one, mixing versions. The tests still use the Couchpotato.Core project.
    -->
    <Compile Include="..\Couchpotato.Core\**\*.cs" Exclude="..\Couchpotato.Core\obj\**;..\Couchpotato.Core\bin\**" LinkBase="Core" />
    <EmbeddedResource Include="..\..\tvapp\**\*" Exclude="..\..\tvapp\**\.DS_Store" LogicalName="tvapp/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="Couchpotato.ico" LogicalName="Couchpotato.ico" />
    <!-- Pointer styles, drawn by tools/make_cursors.py -->
    <EmbeddedResource Include="Cursors\*.png;Cursors\hotspots*.txt" LogicalName="Cursors/%(Filename)%(Extension)" />
    <!-- Manrope UI font, made by tools/make_fonts.py; its licence travels inside the exe with it. -->
    <EmbeddedResource Include="Fonts\*.ttf;Fonts\OFL.txt" LogicalName="Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The DLLs ship as plain files next to Couchpotato.exe (in the release zip), not packed inside it: an exe
    that unpacks libraries in memory looks like malware to antivirus software. The list of files the app
    needs goes inside the exe, so it can install them and tell when they're missing (run from inside the zip).
  -->
  <Target Name="ListAppFiles" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <AppFile Include="@(ReferenceCopyLocalPaths->'%(Filename)%(Extension)')" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
      <AppFile Include="$(AssemblyName).exe.config" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)app-files.txt" Lines="@(AppFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)app-files.txt" LogicalName="app-files.txt" />
    </ItemGroup>
  </Target>

</Project>
