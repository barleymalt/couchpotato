<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Couchpotato</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- The webOS app is embedded so the PC can package and install it without any LG tooling. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tvapp\**\*" Exclude="..\..\tvapp\**\.DS_Store" LogicalName="tvapp/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
